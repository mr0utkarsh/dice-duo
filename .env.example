# ============================================================================
# DICE DUO — Root Environment Variables Example
# Copy to apps/server/.env, apps/mobile/.env, and apps/remote/.env as needed.
# NEVER commit real keys, tokens, or secrets to version control.
# ============================================================================

# --- Backend Server (apps/server/.env) ---
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins (use * in local dev or explicit Vercel URLs in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Secret used to sign player and remote session tokens (replace in production)
SESSION_SECRET=replace-with-a-64-char-random-hex-secret-in-production

# --- Supabase (Optional for Auth & Match History persistence) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder
# Server-only key: NEVER expose SUPABASE_SERVICE_ROLE_KEY to mobile or remote clients!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# --- Frontend Apps (apps/mobile/.env & apps/remote/.env) ---
# Leave empty during local proxy dev, or set to your Render backend URL in production
VITE_SERVER_URL=
VITE_REMOTE_APP_URL=http://localhost:5174
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder
